{
  "name": "react-field-notes",
  "version": "0.1.3",
  "description": "Dev-time annotation overlay for React apps. Tap an element, leave a note, export markdown for your coding agent.",
  "license": "MIT",
  "author": "Leroy Clarke Jr.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyclarkejr/react-field-notes.git"
  },
  "homepage": "https://github.com/leroyclarkejr/react-field-notes#readme",
  "bugs": {
    "url": "https://github.com/leroyclarkejr/react-field-notes/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "keywords": [
    "react",
    "annotation",
    "overlay",
    "devtools",
    "feedback",
    "react-grab"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite6": "npm:vite@^6.4.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-grab": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "react-grab": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
